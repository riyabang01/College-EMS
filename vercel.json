{
  "version": 2,
  "services": {
    "frontend": {
      "root": "client/",
      "buildCommand": "CI=false npm run build"
    },
    "backend": {
      "root": "server/",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
