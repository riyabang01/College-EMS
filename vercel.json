{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "server/server.js"
    },
    {
      "source": "/api/users/(.*)",
      "destination": "server/server.js"
    },
    {
      "source": "/api/events/(.*)",
      "destination": "server/server.js"
    },
    {
      "source": "/api/contact/(.*)",
      "destination": "server/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "server/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "client/build/index.html"
    }
  ]
}
